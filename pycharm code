def get_weather_for_region(region: str):
    if not WEATHER_API_KEY or WEATHER_API_KEY == "YOUR_API_KEY_HERE":
        return {
            "location": region,
            "temp": 18,
            "description": "Partly cloudy",
            "source": "Mock data (satellites, buoys, stations, API)",
        }

    params = {"q": region, "appid": WEATHER_API_KEY, "units": "metric"}
    resp = requests.get(WEATHER_API_URL, params=params, timeout=5)
    resp.raise_for_status()
    data = resp.json()

    return {
        "location": data.get("name", region),
        "temp": round(data["main"]["temp"]),
        "description": data["weather"][0]["description"].title(),
        "source": "Weather API (aggregated from satellites, buoys, stations)",
    }


